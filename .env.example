# ==============================================================================
# AegisOps Environment Configuration Template (Local & Synthetic-Demo Reference)
# NEVER commit `.env.local` or populate real credentials inside `.env.example`.
# WARNING: Copying `.env.example` directly does NOT create a production-safe environment.
# ==============================================================================

# --- AI Provider & Distributed Quota Budgets (Server-side ONLY - NEVER prefix with NEXT_PUBLIC_) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Google Cloud / AI Studio Project Quota Scope identifier (shared across all API keys in the same project; never derived from GEMINI_API_KEY):
GEMINI_QUOTA_SCOPE_ID=your_google_project_id_here
# Set `true` in production so missing GEMINI_QUOTA_SCOPE_ID fails closed instead of using local dev default scope:
AEGIS_REQUIRE_STRICT_GEMINI_QUOTA_SCOPE=false
# Gemini API models (Configuration-only recommendation; live Google project eligibility/quota is UNVERIFIED until cloud smoke test):
# - Primary: `gemini-3.5-flash-lite` (avoids deprecated `gemini-2.5-flash` auto-routing on 2026-12-01).
# - Secondary fallback: `gemini-3.1-flash-lite` is recommended for newly created Google projects because `gemini-2.5-flash-lite`
#   is restricted to existing projects with prior usage (code retains `gemini-2.5-flash-lite` only as a legacy default when unset).
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Layered Public AI Rate Limits (Shared-NAT safe: per-session verified cookie caps < shared per-IP burst):
AI_RATE_LIMIT_PER_MIN=12
AI_SANDBOX_RATE_LIMIT_PER_MIN=8
AI_OCR_RATE_LIMIT_PER_MIN=6
AI_IP_BURST_LIMIT_PER_MIN=36
GEMINI_GLOBAL_RPM_LIMIT=30
GEMINI_GLOBAL_OCR_RPM_LIMIT=12
GEMINI_RPD_RESET_SAFETY_MARGIN_MS=60000
GEMINI_SPEND_LIMIT_COOLDOWN_MS=900000
GEMINI_UNKNOWN_429_COOLDOWN_MS=60000
# TEST-ONLY: isolates Playwright/E2E tests from external Gemini calls.
# Keep true when running isolated E2E tests; not an authentication or production security control.
AEGIS_E2E_DISABLE_EXTERNAL_AI=false

# --- Security & Secret Rotation (>= 32 random chars / 256-bit hex in production) ---
# Run `openssl rand -hex 32` to generate each secret.
AEGIS_SESSION_SECRET=
AEGIS_PII_HMAC_KEY=
# Dedicated secret (>= 32 chars) for `GET /api/health?diagnostics=internal` (`x-aegis-diagnostics-token` header; MUST NOT reuse session/admin secrets):
AEGIS_DIAGNOSTICS_SECRET=
# Dedicated secret (>= 32 chars) for administrative circuit-breaker reset (MUST NOT reuse session, diagnostics, or PII secrets; fails closed if unset):
AEGIS_ADMIN_RESET_SECRET=
# Dedicated secret (>= 32 chars) for scheduled expired-session cleanup (`GET/POST /api/internal/cleanup`, `Authorization: Bearer <CRON_SECRET>`, MUST NOT reuse other secrets):
CRON_SECRET=
# Set `true` in production to fail readiness if GEMINI_FALLBACK_MODEL is unset and would silently fall back to legacy gemini-2.5-flash-lite:
AEGIS_REQUIRE_EXPLICIT_GEMINI_FALLBACK=false
# Optional previous keys kept temporarily during zero-downtime secret rotation:
AEGIS_SESSION_SECRET_PREVIOUS=
AEGIS_PII_HMAC_KEY_PREVIOUS=
# MUST be `true` on public/staging Vercel deployments (fail-closed HTTP 503 if missing):
AEGIS_REQUIRE_STRICT_SECRETS=false
# LOCAL / PROTECTED SYNTHETIC DEMO ONLY.
# This is NOT real authentication or independent Maker-Checker identity.
# Do NOT combine AEGIS_PRODUCTION_STRICT_READINESS=true with demo persona switching enabled.
# Genuine Production: set false only after OIDC/SSO and server-side RBAC are implemented.
AEGIS_ENABLE_DEMO_PERSONA_SWITCH=true
# Master strict production readiness gate (requires Postgres, Upstash Redis, strict secrets, and GEMINI_QUOTA_SCOPE_ID):
AEGIS_PRODUCTION_STRICT_READINESS=false

# --- Shared Persistence (PostgreSQL / Neon Serverless) ---
# Production/Strict Runtime Pooled SSL Postgres URI (MUST use sslmode=verify-full; Neon supports channel_binding=require):
# Example: postgresql://<user>:<password>@<endpoint>-pooler.ap-southeast-1.aws.neon.tech/<dbname>?sslmode=verify-full&channel_binding=require
# Local dev only (when AEGIS_PRODUCTION_STRICT_READINESS=false): postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=
# Direct non-pooled Postgres URI for operator/CI DDL migrations ONLY (`psql "$DIRECT_URL" -f ...`).
# Do NOT expose DIRECT_URL to normal Vercel Serverless runtime functions; keep in migration/operator tooling only.
# Example: postgresql://<migration_user>:<password>@<endpoint>.ap-southeast-1.aws.neon.tech/<dbname>?sslmode=verify-full&channel_binding=require
DIRECT_URL=
# Per-instance pg.Pool max connections (default: 1 on serverless/production, 2 locally; range 1..10)
PG_POOL_MAX=1
# Set `true` in production so cold starts fail-closed instead of silent in-memory fallback:
AEGIS_REQUIRE_SHARED_PERSISTENCE=false

# --- Distributed Rate Limiting & Quota Coordination (Upstash Redis REST `/multi-exec`) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set `true` in production so rate limiting & Redis failures enforce fail-closed protection:
AEGIS_REQUIRE_DISTRIBUTED_RATE_LIMIT=false

# --- Reverse Proxy Trust ---
# Set `true` ONLY when hosted behind Vercel / Cloudflare / ALB setting trusted client IP headers
TRUST_PROXY_HEADERS=false
